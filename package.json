{
  "name": "psbees",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.mjs",
  "description": "PSBees — редактор печатных плат (Sprint-Layout .lay6/.lmk) для Linux и Windows",
  "author": "PSBees",
  "homepage": "https://github.com/danilka-revin/linux_pcb_app",
  "repository": {
    "type": "git",
    "url": "https://github.com/danilka-revin/linux_pcb_app.git"
  },
  "scripts": {
    "dev": "vite",
    "icons": "python3 scripts/make-icons.py",
    "build": "tsc --noEmit && vite build && node scripts/write-version.mjs && node scripts/precompress.mjs",
    "preview": "vite preview",
    "dist:win": "npm run build && node scripts/win/pack.mjs",
    "test:smoke": "esbuild test/smoke.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/smoke.mjs --log-level=warning && node node_modules/.cache/smoke.mjs",
    "test:ssr": "esbuild test/ssr.tsx --bundle --platform=node --format=esm --outfile=node_modules/.cache/ssr.mjs --log-level=warning && node node_modules/.cache/ssr.mjs",
    "test:cloud-ui": "esbuild test/cloud-ui.tsx --bundle --platform=node --format=esm --outfile=node_modules/.cache/cloud-ui.mjs --log-level=warning && node node_modules/.cache/cloud-ui.mjs",
    "test:updater": "esbuild test/updater-dom.tsx --bundle --platform=node --format=esm --external:jsdom --outfile=node_modules/.cache/updater-dom.mjs --log-level=warning && node node_modules/.cache/updater-dom.mjs",
    "test:settings": "esbuild test/settings-dom.tsx --bundle --platform=node --format=esm --external:jsdom --outfile=node_modules/.cache/settings-dom.mjs --log-level=warning && node node_modules/.cache/settings-dom.mjs",
    "test:practice": "esbuild test/practice-dom.tsx --bundle --platform=node --format=esm --external:jsdom --outfile=node_modules/.cache/practice-dom.mjs --log-level=warning && node node_modules/.cache/practice-dom.mjs",
    "test:lay6": "esbuild test/lay6rt.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/lay6rt.mjs --log-level=warning && node node_modules/.cache/lay6rt.mjs",
    "test": "npm run test:smoke && npm run test:group && npm run test:group-dom && npm run test:select-nodes-dom && npm run test:grid && npm run test:gen && npm run test:kicad && npm run test:partreel && npm run test:ssr && npm run test:cloud-ui && npm run test:updater && npm run test:settings && npm run test:practice && npm run test:lay6 && npm run test:route && npm run test:nets && npm run test:inventory && npm run test:cnc && npm run test:server && npm run test:cloud && npm run test:board-shape && npm run test:board-outline-dom && npm run test:board-preview && npm run test:3d && npm run test:modules && npm run test:manual-route && npm run test:trackedit && npm run test:trackedit-route && npm run test:placement && npm run test:track-clearance && npm run test:cnc-dom && npm run test:track-branches && npm run test:track-branches-dom && npm run test:trackcalc && npm run test:imagetrace && npm run test:dim && npm run test:snapguide && npm run test:stats",
    "test:server": "node test/server.mjs",
    "test:cloud": "node test/cloud.mjs",
    "start": "node scripts/server.mjs",
    "start:cloud": "node scripts/server.mjs --cloud",
    "test:route": "esbuild test/autoroute.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/autoroute.mjs --log-level=warning && node node_modules/.cache/autoroute.mjs",
    "test:group": "esbuild test/group.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/group.mjs --log-level=warning && node node_modules/.cache/group.mjs",
    "test:group-dom": "esbuild test/group-dom.tsx --bundle --platform=node --format=esm --external:jsdom --outfile=node_modules/.cache/group-dom.mjs --log-level=warning && node node_modules/.cache/group-dom.mjs",
    "test:select-nodes-dom": "esbuild test/select-nodes-dom.tsx --bundle --platform=node --format=esm --external:jsdom --outfile=node_modules/.cache/select-nodes-dom.mjs --log-level=warning && node node_modules/.cache/select-nodes-dom.mjs",
    "test:grid": "esbuild test/grid.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/grid.mjs --log-level=warning && node node_modules/.cache/grid.mjs",
    "test:nets": "esbuild test/netroute.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/netroute.mjs --log-level=warning && node node_modules/.cache/netroute.mjs",
    "test:inventory": "esbuild test/inventory.tsx --bundle --platform=node --format=esm --outfile=node_modules/.cache/inventory.mjs --log-level=warning && node node_modules/.cache/inventory.mjs",
    "test:cnc": "esbuild test/cnc.tsx --bundle --platform=node --format=esm --outfile=node_modules/.cache/cnc.mjs --log-level=warning && node node_modules/.cache/cnc.mjs",
    "test:gen": "esbuild test/gen.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/gen.mjs --log-level=warning && node node_modules/.cache/gen.mjs",
    "test:kicad": "esbuild test/kicad-footprint.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/kicad-footprint.mjs --log-level=warning && node node_modules/.cache/kicad-footprint.mjs",
    "test:partreel": "esbuild test/partreel-search.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/partreel-search.mjs --log-level=warning && node node_modules/.cache/partreel-search.mjs",
    "test:board-preview": "esbuild test/board-preview.tsx --bundle --platform=node --format=esm --outfile=node_modules/.cache/board-preview.mjs --log-level=warning && node node_modules/.cache/board-preview.mjs",
    "test:3d": "esbuild test/board-preview-3d.tsx --bundle --platform=node --format=esm --outfile=node_modules/.cache/board-preview-3d.mjs --log-level=warning && node node_modules/.cache/board-preview-3d.mjs && esbuild test/board-export-3d.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/board-export-3d.mjs --log-level=warning && node node_modules/.cache/board-export-3d.mjs",
    "test:preview-browser": "playwright test --config test/preview.playwright.config.ts",
    "test:modules": "node test/modules-api.mjs",
    "test:manual-route": "esbuild test/manual-route.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/manual-route.mjs --log-level=warning && node node_modules/.cache/manual-route.mjs",
    "test:placement": "esbuild test/autoplace.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/autoplace.mjs --log-level=warning && node node_modules/.cache/autoplace.mjs",
    "test:layout-browser": "playwright test --config test/auto-layout.playwright.config.ts",
    "test:trackedit": "esbuild test/trackedit.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/trackedit.mjs --log-level=warning && node node_modules/.cache/trackedit.mjs",
    "test:trackedit-route": "esbuild test/trackedit-route.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/trackedit-route.mjs --log-level=warning && node node_modules/.cache/trackedit-route.mjs",
    "test:board-shape": "esbuild test/board-shape.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/board-shape.mjs --log-level=warning && node node_modules/.cache/board-shape.mjs",
    "test:board-outline-dom": "esbuild test/board-outline-dom.tsx --bundle --platform=node --format=esm --external:jsdom --outfile=node_modules/.cache/board-outline-dom.mjs --log-level=warning && node node_modules/.cache/board-outline-dom.mjs",
    "test:track-clearance": "esbuild test/track-clearance.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/track-clearance.mjs --log-level=warning && node node_modules/.cache/track-clearance.mjs",
    "test:cnc-dom": "esbuild test/cnc-dom.tsx --bundle --platform=node --format=esm --external:jsdom --outfile=node_modules/.cache/cnc-dom.mjs --log-level=warning && node node_modules/.cache/cnc-dom.mjs",
    "test:cnc-browser": "playwright test --config test/cnc.playwright.config.ts",
    "test:track-branches": "esbuild test/track-branches.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/track-branches.mjs --log-level=warning && node node_modules/.cache/track-branches.mjs",
    "test:track-branches-dom": "esbuild test/track-branches-dom.tsx --bundle --platform=node --format=esm --external:jsdom --outfile=node_modules/.cache/track-branches-dom.mjs --log-level=warning && node node_modules/.cache/track-branches-dom.mjs",
    "test:trackcalc": "esbuild test/trackcalc.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/trackcalc.mjs --log-level=warning && node node_modules/.cache/trackcalc.mjs",
    "test:imagetrace": "esbuild test/imagetrace.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/imagetrace.mjs --log-level=warning && node node_modules/.cache/imagetrace.mjs",
    "test:dim": "esbuild test/dim.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/dim.mjs --log-level=warning && node node_modules/.cache/dim.mjs",
    "test:snapguide": "esbuild test/snapguide.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/snapguide.mjs --log-level=warning && node node_modules/.cache/snapguide.mjs",
    "test:stats": "esbuild test/stats.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/stats.mjs --log-level=warning && node node_modules/.cache/stats.mjs"
  },
  "dependencies": {
    "clipper-lib": "^6.4.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/clipper-lib": "^6.4.0",
    "@types/node": "^22.20.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^27.4.0",
    "typescript": "^5.6.3",
    "vite": "^6.3.5"
  },
  "build": {
    "appId": "app.psbees.pcb",
    "productName": "PSBees",
    "copyright": "PSBees",
    "electronVersion": "33.4.11",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "scripts/*.mjs",
      "scripts/icon.svg",
      "dist/**/*",
      "build/icon.png",
      "build/icon.ico"
    ],
    "extraMetadata": {
      "main": "electron/main.mjs"
    },
    "win": {
      "icon": "build/icon.ico",
      "executableName": "PSBees",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PSBees",
      "uninstallDisplayName": "PSBees — редактор печатных плат",
      "deleteAppDataOnUninstall": false,
      "artifactName": "PSBees-Setup-${version}.${ext}",
      "installerLanguages": [
        "ru_RU",
        "en_US"
      ],
      "language": "1049"
    },
    "portable": {
      "artifactName": "PSBees-portable-${version}.${ext}"
    }
  }
}
