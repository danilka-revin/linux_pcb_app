# ==============================================
# 🎯 ГОТОВЫЙ ПРЕСЕТ ДЛЯ БЕСПЛАТНОГО TEAMOROUTER
# ==============================================
# ⚠️ ЭТОТ ФАЙЛ — ТОЛЬКО ДЛЯ NODE-СКРИПТОВ (src/utils/aiClient.js).
#    Сама программа PSBees работает в браузере и .env НЕ читает:
#    ключ вставляется в «Настройки → ИИ-помощник» (пресет «TeamoRouter (бесплатно)»,
#    адрес https://api.teamorouter.com/v1, модель deepseek-v4-flash-free).
#    Подробно — в AI_PRESET_GUIDE.md.
# ИНСТРУКЦИЯ:
# 1. Скопируй этот файл как .env в корень проекта
# 2. Вставь свой API ключ от TeamoRouter в TEAMO_API_KEY (он начинается с tr-)
# 3. (Опционально) Если закончится дневной лимит на Teamo, вставь ключ от NaraRouter в NARA_API_KEY (он начинается с sk-nry-)
# 4. ВСЕ ОСТАЛЬНЫЕ НАСТРОЙКИ УЖЕ ЗАПОЛНЕНЫ, НИЧЕГО МЕНЯТЬ НЕ НУЖНО!

# === Основной провайдер (TeamoRouter, 200 запросов в день на каждую модель) ===
TEAMO_API_KEY=tr-ВСТАВЬ_СВОЙ_КЛЮЧ_ТУТ
TEAMO_BASE_URL=https://api.teamorouter.com/v1
TEAMO_FAST_MODEL=deepseek-v4-flash-free
TEAMO_SMART_MODEL=deepseek-v4-pro-free

# === Резервный провайдер (NaraRouter, 7 млн токенов в день, подключается если закончится лимит на Teamo) ===
NARA_API_KEY=
NARA_BASE_URL=https://router.bynara.id/v1
NARA_MODEL=deepseek-v4-pro

# === Настройки по умолчанию (не менять) ===
AI_DEFAULT_TEMPERATURE=0.2
AI_MAX_TOKENS=4096
AI_THINKING_MODE_ENABLED=true
